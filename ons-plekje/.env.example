# Kopieer dit bestand naar ".env" en vul je eigen sleutels in.
#
# Windows:  copy .env.example .env
# Mac:      cp .env.example .env
#
# Alles met EXPO_PUBLIC_ ervoor komt in de app terecht; dat hoort zo voor deze
# sleutels. Zet je .env nooit op GitHub (.gitignore regelt dat al).

# --- Firebase: jullie kaart, de plekjes en het inloggen ---------------------
# Projectinstellingen > Je apps > Web-app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Cloudinary: de foto's --------------------------------------------------
# Cloud name staat op je dashboard; de preset maak je aan onder
# Settings > Upload > Upload presets (zet hem op "Unsigned").
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Google Maps ------------------------------------------------------------
# Let op: hiervoor heeft Google een betaalrekening nodig, ook al is de kaart
# zelf gratis. Heb je die niet, laat deze dan leeg — zie README.md.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
