# Kopieer dit bestand naar ".env" en vul je eigen sleutels in.
# Alles met EXPO_PUBLIC_ ervoor komt in de app terecht; dat hoort zo voor
# Firebase-webconfig en Maps-sleutels. Zet je .env nooit op GitHub.

# --- Firebase (Projectinstellingen > Je apps > Web-app) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Maps (Google Cloud Console > API's en services > Inloggegevens) ---
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
