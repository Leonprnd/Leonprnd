{%- comment -%}
  BESTAND : faq.liquid   LOCATIE: Sections → faq.liquid
  COPY    : 14-productpagina.md, deel 3
  --------------------------------------------------------------------------
  Levert ook FAQPage-structured data, zodat Google de vragen kan uitklappen
  in de zoekresultaten. Dat is gratis extra zichtbaarheid.
{%- endcomment -%}

<div class="zw">
  <section class="zw__sectie zw__sectie--papier">
    <div class="zw__wrap">
      <div style="max-width:800px;margin-inline:auto">
        <h2 class="zw__centreer">{{ section.settings.kop }}</h2>

        <div data-zw-faq style="margin-top:32px">
          {%- for block in section.blocks -%}
            <details class="zw__uitklap"
                     {% if forloop.index <= section.settings.aantal_open %}open{% endif %}
                     {{ block.shopify_attributes }}>
              <summary>{{ block.settings.vraag }}</summary>
              <div class="zw__uitklap-inhoud">{{ block.settings.antwoord }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.vraag | strip_html | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.antwoord | strip_html | json }}
        }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Veelgestelde vragen",
  "settings": [
    { "type": "text", "id": "kop", "label": "Kop", "default": "Veelgestelde vragen" },
    { "type": "range", "id": "aantal_open", "label": "Aantal standaard geopend", "min": 0, "max": 4, "step": 1, "default": 2 }
  ],
  "blocks": [
    {
      "type": "vraag", "name": "Vraag",
      "settings": [
        { "type": "text", "id": "vraag", "label": "Vraag" },
        { "type": "richtext", "id": "antwoord", "label": "Antwoord" }
      ]
    }
  ],
  "presets": [{ "name": "Veelgestelde vragen" }]
}
{% endschema %}
