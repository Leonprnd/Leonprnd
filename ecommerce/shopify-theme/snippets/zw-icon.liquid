{%- comment -%}
  BESTAND     : zw-icon.liquid
  LOCATIE     : Shopify-thema → Snippets → zw-icon.liquid
  GEBRUIK     : {%- render 'zw-icon', naam: 'loep' -%}
  --------------------------------------------------------------------------
  Lijnpictogrammen, 2px lijndikte, afgeronde uiteinden, currentColor.
  Altijd aria-hidden: op deze site staat naast elk pictogram een tekstlabel,
  dus de screenreader hoeft het icoon niet te benoemen.
{%- endcomment -%}

{%- liquid
  assign n = naam | default: 'vinkje'
-%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- case n -%}
  {%- when 'telefoon' -%}
    <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5L17 13l4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4 5.2 2 2 0 0 1 6 3z"/>
  {%- when 'loep' -%}
    <circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/>
  {%- when 'oog' -%}
    <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="2.6"/>
  {%- when 'lamp' -%}
    <path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9V16h7v-2.1A6 6 0 0 0 12 3z"/>
  {%- when 'klok' -%}
    <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>
  {%- when 'gebogen' -%}
    <circle cx="13" cy="4.5" r="2"/><path d="M13 7c-1 2.5-3.5 4-6 4.5M13 7c1.5 1 2 3 1.5 5l-3 6M8.5 13l-2.5 7"/>
  {%- when 'steek' -%}
    <path d="M3 8c3 3 6 3 9 0s6-3 9 0"/><path d="M3 16c3 3 6 3 9 0"/><path d="M16 17l5 4M21 17l-5 4"/>
  {%- when 'doos' -%}
    <path d="M3 8l9-4 9 4v8l-9 4-9-4z"/><path d="M3 8l9 4 9-4M12 12v8"/>
  {%- when 'retour' -%}
    <path d="M3 12a9 9 0 1 0 2.6-6.4"/><path d="M3 4v5h5"/>
  {%- when 'schild' -%}
    <path d="M12 3l8 3v6c0 5-3.4 8.3-8 9-4.6-.7-8-4-8-9V6z"/><path d="M8.8 12l2.2 2.2 4.2-4.4"/>
  {%- when 'envelop' -%}
    <rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
  {%- when 'vraag' -%}
    <circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.3 2.4c-.6.2-.8.7-.8 1.3v.4"/><path d="M12 17h.01"/>
  {%- when 'klem' -%}
    <path d="M5 4v9a3 3 0 0 0 3 3h8"/><rect x="3" y="13" width="7" height="6" rx="1.5"/><path d="M16 13v6"/>
  {%- when 'knop' -%}
    <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v4.5"/>
  {%- else -%}
    <path d="M4.5 12.5l5 5L20 7"/>
{%- endcase -%}
</svg>
